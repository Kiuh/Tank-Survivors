--- !u!114 &366663130
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 366663128}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e70e389eb2a665b4f839b4cd1d109766, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  graphic: {fileID: 619721577}
  graphicFadeInTime: 0.6
  graphicFadeOutTime: 1
  exitButton: {fileID: 205489683}
  continueButton: {fileID: 205021508}
  descriptionLabel: {fileID: 177842200}
  descriptions:
  - Text: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 <color=red>\u043F\u0430\u043B\u0435\u0446</color>
      \u0438\u043B\u0438 <color=red>\u041B\u041A\u041C</color> \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435
      \u0434\u043B\u044F <color=red>\u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F</color>
      \u0441\u0442\u0438\u043A\u0430. \r\n\n\u0422\u0430\u043D\u043A <color=red>\u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438</color>
      \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u0432\u0440\u0430\u0433\u0430."
    Sprite: {fileID: 21300000, guid: 577001888020ef942afb47c393238739, type: 3}
  - Text: "\u041F\u043E\u0441\u043B\u0435 <color=red>\u0441\u043C\u0435\u0440\u0442\u0438</color>
      \u0432\u0440\u0430\u0433\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      <color=red>\u043E\u043F\u044B\u0442 \u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435</color>.\r\n\n\u041D\u0430\u043A\u043E\u043F\u0438\u0432
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043E\u043F\u044B\u0442\u0430,
      \u0442\u044B <color=red>\u043F\u043E\u0432\u044B\u0441\u0438\u0448\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C</color>."
    Sprite: {fileID: 21300000, guid: 0dfb895816af003409957d27629adf7e, type: 3}
  - Text: "<color=red>\u041F\u043E\u0432\u044B\u0441\u0438\u0432</color> \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0443\u0440\u043E\u0432\u043D\u0435\u0439, \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C
      <color=red>\u0441\u043C\u0435\u043D\u0438\u0442\u044C \u043F\u0443\u0448\u043A\u0443</color>.\r\n\n\u0412
      \u043C\u0435\u043D\u044E \u043F\u0430\u0443\u0437\u044B \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0443\u0437\u043D\u0430\u0442\u044C \u043E \u0442\u0435\u043A\u0443\u0449\u0438\u0445
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u0445
      \u0441\u0432\u043E\u0435\u0433\u043E \u0442\u0430\u043D\u043A\u0430 \u0438
      \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u043F\u0443\u0448\u043A\u0438."
    Sprite: {fileID: 21300000, guid: bc43400cba12aee4db4a4fe3d33894e9, type: 3}
  - Text: "\u0417\u0430 <color=red>\u0443\u0431\u0438\u0442\u043E\u0433\u043E \u0411\u043E\u0441\u0441\u0430</color>
      \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0448\u044C <color=red>1
      \u0437\u0432\u0435\u0437\u0434\u0443</color> \u0438\u0437 3-\u0445.\r\n\n\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043E\u0434\u043D\u043E\u0439 \u0437\u0432\u0435\u0437\u0434\u044B \u0434\u043B\u044F
      \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F."
    Sprite: {fileID: 21300000, guid: 037425349b473294fa98a93573e8e8d5, type: 3}
